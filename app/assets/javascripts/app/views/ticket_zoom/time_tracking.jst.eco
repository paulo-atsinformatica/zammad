<div class="ticket-time-tracking-player">
  <button type="button" class="tt-btn js-tt-start" title="<%- @T('Iniciar contagem') %>" disabled>
    <svg class="icon-small" viewBox="0 0 14 14" aria-hidden="true">
      <path d="M4 3.5L11 7L4 10.5Z"></path>
    </svg>
  </button>
  <button type="button" class="tt-btn js-tt-pause" title="<%- @T('Pausar contagem') %>" disabled>
    <svg class="icon-small" viewBox="0 0 14 14" aria-hidden="true">
      <rect x="4" y="3" width="2.5" height="8"></rect>
      <rect x="7.5" y="3" width="2.5" height="8"></rect>
    </svg>
  </button>
  <div class="tt-timer js-tt-timer">00:00:00</div>
  <%# Tempo somado de todos os atendentes, exibido só quando o ticket passou por
      mais de um. O detalhe por pessoa vai no title. %>
  <div class="tt-others js-tt-others hide"></div>
</div>
