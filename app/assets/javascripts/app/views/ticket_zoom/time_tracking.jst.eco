<div class="ticket-time-tracking-player">
  <%# Tempo por atendente. Fica à ESQUERDA do play e atrás de um clique: à direita do cronômetro os dois números ficavam colados e não dava para saber qual era qual. Só aparece quando mais de um atendente trabalhou. %>
  <div class="tt-others-wrap js-tt-others-wrap hide">
    <button type="button" class="tt-btn js-tt-others" title="<%- @T('Tempo por atendente') %>" aria-haspopup="true" aria-expanded="false">
      <svg class="icon-small" viewBox="0 0 14 14" aria-hidden="true">
        <circle cx="5" cy="4.5" r="2.2"></circle>
        <circle cx="10.3" cy="5.2" r="1.7"></circle>
        <path d="M1 12c0-2.2 1.8-3.6 4-3.6s4 1.4 4 3.6z"></path>
        <path d="M9.7 12c0-1.5-.5-2.6-1.4-3.3.6-.2 1.3-.3 2-.3 1.8 0 3.2 1.1 3.2 2.9V12z"></path>
      </svg>
    </button>
    <div class="tt-others-popover js-tt-others-popover hide"></div>
  </div>
  <button type="button" class="tt-btn js-tt-start" title="<%- @T('Iniciar contagem') %>" disabled>
    <svg class="icon-small" viewBox="0 0 14 14" aria-hidden="true">
      <path d="M4 3.5L11 7L4 10.5Z"></path>
    </svg>
  </button>
  <div class="tt-timer js-tt-timer">00:00:00</div>
</div>
