<div class="page-header">
  <div class="page-header-title">
    <h2><%- @T(@overview.name) %></h2>
  </div>
  <div class="page-header-meta">
    <%# Customização ATS: recarrega a lista sem recarregar a página inteira. Fora do @edit, que é só admin. %>
    <div class="btn btn--action btn--icon--last js-overviewRefresh" data-type="refresh"><%- @T('Refresh') %> <%- @Icon('reload') %></div>
    <% if @edit: %>
      <div class="btn btn--action" data-type="settings"><%- @T('Options') %></div>
    <% end %>
  </div>
</div>

<div class="page-content">
  <div class="table-overview"></div>
</div>

<div class="bulkAction hide"></div>
