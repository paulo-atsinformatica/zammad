<div class="main flex reporting">
  <div class="page-header">
    <div class="page-header-title">
      <h1><%- @T('Custom Report') %> <small></small></h1>
    </div>
  </div>

  <div class="page-body">
    <div class="page-main">
      <div class="btn--group">
        <a class="btn js-visibility <%= 'btn--primary' if @visibility is 'all' %>" data-visibility="all"><%- @T('All') %></a>
        <a class="btn js-visibility <%= 'btn--primary' if @visibility is 'global' %>" data-visibility="global"><%- @T('Global') %></a>
        <a class="btn js-visibility <%= 'btn--primary' if @visibility is 'group' %>" data-visibility="group"><%- @T('Group') %></a>
        <a class="btn js-visibility <%= 'btn--primary' if @visibility is 'personal' %>" data-visibility="personal"><%- @T('Personal view') %></a>
      </div>

      <div class="js-reports"></div>

      <h2><%- @T('Generations') %></h2>
      <p class="help-block">
        <%- @T('Reports are generated in the background so that a large export does not affect the system. You can keep working while it runs.') %>
      </p>
      <div class="js-runs"></div>
    </div>
  </div>
</div>
