<% if _.isEmpty(@runs): %>
  <p class="help-block"><%- @T('No generation yet.') %></p>
<% else: %>
  <table class="table table--light">
    <thead>
      <tr>
        <th><%- @T('Requested') %></th>
        <th><%- @T('Format') %></th>
        <th><%- @T('Status') %></th>
        <th><%- @T('Progress') %></th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% for run in @runs: %>
        <tr data-id="<%= run.id %>">
          <td><%- @humanTime(run.created_at) %></td>
          <td><%= run.format.toUpperCase() %></td>
          <td>
            <% if run.status is 'pending': %><%- @T('Queued') %><% end %>
            <% if run.status is 'running': %><%- @T('Generating') %><% end %>
            <% if run.status is 'succeeded': %><%- @T('Ready') %><% end %>
            <% if run.status is 'failed': %>
              <span class="text-danger" title="<%= run.error %>"><%- @T('Failed') %></span>
            <% end %>
          </td>
          <td>
            <%# total_rows só existe apos a contagem inicial. %>
            <% if run.status in ['pending', 'running']: %>
              <% if run.total_rows: %>
                <%= run.processed_rows %> / <%= run.total_rows %>
                <% if run.progress_percent isnt null: %>(<%= run.progress_percent %>%)<% end %>
              <% else: %>
                <%- @T('Counting rows...') %>
              <% end %>
            <% else: %>
              <%= run.processed_rows %> <%- @T('row(s)') %>
            <% end %>
          </td>
          <td class="align-right">
            <% if run.downloadable: %>
              <%# GET autenticado direto, fora do SPA: o navegador cuida do arquivo grande. %>
              <a class="btn btn--success" href="<%= @apiPath %>/custom_report_runs/<%= run.id %>/download"><%- @T('Download') %></a>
            <% end %>
            <% if run.status is 'failed': %>
              <span class="text-muted"><%= run.error %></span>
            <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% end %>
