<div class="main flex reporting">
  <div class="page-header">
    <div class="page-header-title">
      <h1><%- @T('Relatório de Pausas de Usuários') %> <small></small></h1>
    </div>
  </div>

  <div class="page-body">
    <div class="page-main">
      <div class="report-filters well">
        <div class="report-filters-grid">
          <div class="form-group report-filter-field">
            <label><%- @T('Data Inicial') %></label>
            <input type="text" class="form-control js-start-date" readonly>
          </div>
          <div class="form-group report-filter-field">
            <label><%- @T('Data Final') %></label>
            <input type="text" class="form-control js-end-date" readonly>
          </div>
          <div class="form-group report-filter-field">
            <label><%- @T('Tipo de Pausa') %></label>
            <select class="form-control js-pause-type"></select>
          </div>
          <div class="form-group report-filter-field">
            <label><%- @T('Tempo excedido') %></label>
            <select class="form-control js-exceeded-filter">
              <option value="all"><%- @T('Todos') %></option>
              <option value="yes"><%- @T('Sim') %></option>
              <option value="no"><%- @T('Não') %></option>
            </select>
          </div>
          <div class="form-group report-filter-field">
            <label><%- @T('Agente') %></label>
            <input type="text" class="form-control js-agent-query" placeholder="<%- @T('Nome ou email') %>">
          </div>
        </div>
        <div class="report-filters-actions">
          <button type="button" class="btn btn--primary js-report-search"><%- @T('Pesquisar') %></button>
        </div>
      </div>
      <div class="js-report-content"></div>
    </div>
  </div>
</div>
