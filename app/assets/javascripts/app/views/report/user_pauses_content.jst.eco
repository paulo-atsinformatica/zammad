<div class="report-content">
  <table class="table">
    <thead>
      <tr>
        <th><%- @T('Agente') %></th>
        <th><%- @T('Nome da Pausa/Login/Logout') %></th>
        <th><%- @T('Data') %></th>
        <th><%- @T('Hora') %></th>
        <th><%- @T('Hora Fim') %></th>
        <th><%- @T('Tempo Máximo Permitido') %></th>
        <th><%- @T('Duração Total') %></th>
        <th><%- @T('Tempo excedido') %></th>
      </tr>
    </thead>
    <tbody>
      <% if !@data.entries || @data.entries.length == 0: %>
      <tr>
        <td colspan="8"><%- @T('Nenhum registro encontrado') %></td>
      </tr>
      <% else: %>
        <% for item in @data.entries: %>
          <tr>
            <td><%= item.agent?.firstname %> <%= item.agent?.lastname %></td>
            <td><%= item.name %></td>
            <td><%= @formatDate(item.started_at) %></td>
            <td><%= @formatTime(item.started_at) %></td>
            <td><%= @formatTime(item.ended_at) %></td>
            <% if item.time_limit: %>
              <td><%= item.time_limit %></td>
            <% else: %>
              <td>-</td>
            <% end %>
            <td><%= @formatDuration(item.duration_seconds) %></td>
            <% if item.exceeded: %>
              <td><%- @T('Sim') %></td>
            <% else: %>
              <td><%- @T('Não') %></td>
            <% end %>
          </tr>
        <% end %>
      <% end %>
    </tbody>
  </table>
</div>




