<div class="pause-blocker-overlay">
  <div class="pause-blocker-content">
    <div class="pause-blocker-icon">
      <%- @Icon('clock', 'icon-large') %>
    </div>
    <h2><%- @T('Você está em pausa') %></h2>
    <% if @pauseType: %>
    <p class="pause-type-name"><%- @Ti(@pauseType.name) %></p>
    <% end %>
    <p class="pause-message"><%- @T('Você não pode realizar ações enquanto estiver em pausa.') %></p>
    <button class="btn btn--primary js-exit-pause">
      <%- @T('Sair da Pausa') %>
    </button>
  </div>
</div>




