msgstr "Remetente do primeiro artigo"

msgid "Create article type"
msgstr "Tipo do primeiro artigo"

msgid "First response at"
msgstr "Primeira resposta em"

msgid "First response diff in min"
msgstr "Diferença da primeira resposta (min)"

msgid "First response escalation at"
msgstr "Escalonamento da primeira resposta em"

msgid "First response in min"
msgstr "Tempo até a primeira resposta (min)"

msgid "Last close at"
msgstr "Último fechamento em"

msgid "Last contact agent at"
msgstr "Último contato do atendente em"

msgid "Last contact at"
msgstr "Último contato em"

msgid "Last contact customer at"
msgstr "Último contato do cliente em"

msgid "Last owner update at"
msgstr "Última troca de proprietário em"

msgid "Pending time"
msgstr "Aguardando até"

